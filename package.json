{
  "name": "auth-service",
  "version": "0.0.1",
  "private": true,
  "description": "CPF/CNPJ authentication Lambda that issues JWTs for the tech-challenge microservices",
  "scripts": {
    "start:dev": "node --import tsx src/local-server.ts",
    "start:serverless": "serverless offline start --stage dev",
    "build": "esbuild src/local-server.ts --bundle --platform=node --target=node22 --outfile=dist/local-server.js",
    "start": "node dist/local-server.js",
    "package": "serverless package --stage dev",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:ci": "jest --config ./tests/jest-cov.json --coverage --runInBand",
    "lint": "eslint \"{src,tests}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,tests}/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "jsonwebtoken": "9.0.2",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.145",
    "@types/jest": "29.5.13",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "22.7.5",
    "@typescript-eslint/eslint-plugin": "8.9.0",
    "@typescript-eslint/parser": "8.9.0",
    "esbuild": "0.24.0",
    "eslint": "9.12.0",
    "eslint-config-prettier": "9.1.0",
    "jest": "29.7.0",
    "prettier": "3.3.3",
    "serverless": "3.39.0",
    "serverless-esbuild": "1.54.6",
    "serverless-offline": "13.9.0",
    "ts-jest": "29.2.5",
    "tsx": "4.19.1",
    "typescript": "5.6.3"
  },
  "packageManager": "pnpm@10.32.1"
}
